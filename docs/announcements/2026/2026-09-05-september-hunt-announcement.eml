                <tr>
                  <td width="50%"
                      style="color:#ffffff;font-size:14px;
                             line-height:1.8;vertical-align:top;">
                    <strong>Date:</strong>
                    Sun Sep 20, 2026 <em>(tentative)</em><br>
                    <strong>Start:</strong> TBD (morning)
                  </td>
                  <td width="50%"
                      style="color:#ffffff;font-size:14px;
                             line-height:1.8;vertical-align:top;">
                    <strong>Finish:</strong> TBD in announced
                    hunt area<br>
                    <strong>Type:</strong> Regional mobile
                    T-hunt, on-foot final leg
                  </td>
                </tr>
